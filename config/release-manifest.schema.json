{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex RV64 v1 release evidence manifest",
  "type": "object",
  "required": ["schema_version", "phase", "project_commit", "gates", "artifacts"],
  "properties": {
    "schema_version": {"const": 1},
    "phase": {"const": "v1.0.0"},
    "project_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "gates": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status", "report", "sha256"],
        "properties": {
          "status": {"const": "pass"},
          "report": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
